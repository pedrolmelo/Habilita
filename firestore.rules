rules_version = '2';

// Nega TODO acesso direto ao Firestore. O acesso é só pela API (Admin SDK, que ignora
// estas regras). Os testes das Security Rules vêm no Prompt 4.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
