# =====================================================================
# .env.example — MODELO de variáveis de ambiente do Habilita
#
# O `.env` é OPCIONAL: `docker compose up` funciona sem ele, com os valores padrão.
# Copie para `.env` (cp .env.example .env) só se quiser sobrescrever algum valor.
# NUNCA commite o `.env`: ele é ignorado pelo Git de propósito.
# Este arquivo contém apenas valores falsos, vazios ou de desenvolvimento local.
# =====================================================================

# --- Aplicação ---
# Ambiente em que a aplicação está rodando (local, ci, prod).
APP_ENV=local
# Nível de detalhe dos logs (debug, info, warning, error). Logs nunca devem conter dados pessoais.
LOG_LEVEL=info

# --- Portas no SEU computador (lado de fora do Docker) ---
# O Compose publica tudo só em 127.0.0.1. Mude a porta daqui se ela já estiver ocupada.
# (As portas DENTRO dos contêineres são fixas: API 8000, web 5173, Storage 5000.)
API_HOST_PORT=8000
WEB_HOST_PORT=5173
EMULATOR_UI_HOST_PORT=4000
AUTH_EMULATOR_HOST_PORT=9099
FIRESTORE_EMULATOR_HOST_PORT=8080
STORAGE_HOST_PORT=5000

# --- Porta da API DENTRO do contêiner ---
# O Compose já define PORT=8000 para o serviço `api`. Só defina aqui se for rodar a API fora do Docker.
# PORT=8000

# --- Proxy do frontend ---
# Para onde o servidor do Vite manda as chamadas /api/*. Padrão (Compose): http://api:8000.
# Só defina se rodar o web FORA do Docker (aí use http://localhost:8000).
# API_PROXY_TARGET=http://localhost:8000

# --- Firebase ---
# ID do projeto Firebase. IDs que começam com `demo-` fazem os emuladores rodarem
# sem nenhum projeto real no Google Cloud (nenhum recurso de nuvem é usado e o gasto é zero).
FIREBASE_PROJECT_ID=demo-habilita

# --- Emuladores do Firebase (Firebase Emulator Suite) ---
# Quando estas variáveis existem, o SDK Admin conecta nos emuladores locais em vez da nuvem.
# Nomes conferidos na documentação oficial (firebase.google.com/docs/emulator-suite).
#
# Há DOIS contextos, com valores diferentes:
#
# 1) DENTRO dos contêineres (serviço `api` do Compose): o host é o nome do serviço
#    `emulators`. O docker-compose.yml já define estes valores; você NÃO precisa
#    copiá-los para o `.env`:
#      FIREBASE_AUTH_EMULATOR_HOST=emulators:9099
#      FIRESTORE_EMULATOR_HOST=emulators:8080
#
# 2) Na SUA MÁQUINA (por exemplo, rodando a API ou um script com `uv run` fora do Docker,
#    com os emuladores do Compose ligados): o host é `localhost`. São os valores abaixo.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Supabase Storage (Ambiente Local / Desenvolvimento) ---
# ATENÇÃO: Os valores abaixo são estritamente para desenvolvimento local e testes,
# sem qualquer valor de segurança ou acesso a ambientes reais.
# Segredo JWT local compartilhado usado pelo Supabase Storage (mínimo de 32 caracteres).
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Chave anon para testes locais (pública no cliente):
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
# Chave service_role para testes locais (NUNCA expor no navegador; usada apenas na API e Seed):
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Configurações do Bucket de Documentos
STORAGE_BUCKET=documentos
STORAGE_MAX_BYTES=5242880
STORAGE_ALLOWED_MIME=application/pdf,image/jpeg

# --- Segurança / dados pessoais ---
# Chave usada para gerar o hash HMAC do CPF (o CPF nunca é guardado em texto puro).
# Localmente, gere um valor aleatório, por exemplo: python -c "import secrets; print(secrets.token_hex(32))"
# O valor local NUNCA pode ser igual ao de produção. Deixe vazio aqui no modelo.
CPF_HMAC_KEY=
